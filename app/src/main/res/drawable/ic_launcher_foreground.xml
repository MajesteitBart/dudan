<?xml version="1.0" encoding="utf-8"?>
<!-- The aight orb from assets/aight-icon.svg, in the same 400-unit coordinates. Vector drawables
     have no blur, so the two soft glows are radial gradients with a Gaussian falloff. The splash
     screen shows this layer on its own, so the floor glow lives in the background layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="400"
    android:viewportHeight="400">
    <!-- Violet halo around the orb. -->
    <path android:pathData="M63.625,200 a136.5,136.5 0 1,0 273,0 a136.5,136.5 0 1,0 -273,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="200.125"
                android:centerY="200"
                android:gradientRadius="136.5"
                android:type="radial">
                <item android:color="#707A5CFF" android:offset="0" />
                <item android:color="#707A5CFF" android:offset="0.3407" />
                <item android:color="#617A5CFF" android:offset="0.4725" />
                <item android:color="#397A5CFF" android:offset="0.6044" />
                <item android:color="#127A5CFF" android:offset="0.7363" />
                <item android:color="#037A5CFF" android:offset="0.8681" />
                <item android:color="#007A5CFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orb. -->
    <path android:pathData="M121.75,200 a78.375,78.375 0 1,0 156.75,0 a78.375,78.375 0 1,0 -156.75,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="160.938"
                android:endY="278.375"
                android:startX="239.313"
                android:startY="121.625"
                android:type="linear">
                <item android:color="#FFB867F7" android:offset="0" />
                <item android:color="#FF7061F1" android:offset="0.45" />
                <item android:color="#FF4A63EE" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shade on the lower half of the orb. -->
    <group>
        <clip-path android:pathData="M121.75,200 a78.375,78.375 0 1,0 156.75,0 a78.375,78.375 0 1,0 -156.75,0 Z" />
        <path android:pathData="M95.625,285.25 a79.75,79.75 0 1,0 159.5,0 a79.75,79.75 0 1,0 -159.5,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="191.325"
                    android:endY="365"
                    android:startX="95.625"
                    android:startY="205.5"
                    android:type="linear">
                    <item android:color="#FF4658E6" android:offset="0" />
                    <item android:color="#FF2F40C9" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Soft shadow that separates the moon from the orb. -->
    <path android:pathData="M178.75,233 a57.125,57.125 0 1,0 114.25,0 a57.125,57.125 0 1,0 -114.25,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="235.875"
                android:centerY="233"
                android:gradientRadius="57.125"
                android:type="radial">
                <item android:color="#963A5BE8" android:offset="0" />
                <item android:color="#963A5BE8" android:offset="0.7374" />
                <item android:color="#813A5BE8" android:offset="0.7899" />
                <item android:color="#4D3A5BE8" android:offset="0.8425" />
                <item android:color="#183A5BE8" android:offset="0.895" />
                <item android:color="#033A5BE8" android:offset="0.9475" />
                <item android:color="#003A5BE8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Moon. -->
    <path android:pathData="M190.5,233 a45.375,45.375 0 1,0 90.75,0 a45.375,45.375 0 1,0 -90.75,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="222.262"
                android:centerY="214.85"
                android:gradientRadius="68.0625"
                android:type="radial">
                <item android:color="#FFA9C2FF" android:offset="0" />
                <item android:color="#FF7F9FF8" android:offset="0.6" />
                <item android:color="#FF5F84F0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
