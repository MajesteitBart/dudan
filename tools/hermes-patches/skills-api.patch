+    @_require_auth
+    async def _handle_skill_detail(self, request: "web.Request") -> "web.Response":
+        """GET /v1/skills/{name} — one skill's SKILL.md, raw (``content``) and after its frontmatter
+        (``body``), with name, description, category and linked files. Names resolve like
+        skill_view, but read-only: no dependency installs, no view or use counts."""
+        name = request.match_info["name"]
+        try:
+            from agent.skill_utils import parse_frontmatter
+            from tools.skills_tool import (
+                _get_category_from_path, _locate_skill, _read_skill_text, _skill_linked_files,
+                _skill_lookup_path_error, _skill_search_dirs)
+            if lookup_error := _skill_lookup_path_error(name):
+                return _error_response(lookup_error, 400)
+
+            def _load():
+                project_dirs, all_dirs, active_skills_dir = _skill_search_dirs()
+                error, skill_dir, skill_md = _locate_skill(name, None, project_dirs, all_dirs)
+                if error is not None:
+                    return json.loads(error).get("error") or f"Skill '{name}' not found.", None
+                content = _read_skill_text(skill_md)
+                frontmatter, body = parse_frontmatter(content)
+                try:
+                    path = skill_md.relative_to(active_skills_dir).as_posix()
+                except ValueError:  # external dir: relative to the skill's own parent
+                    path = skill_md.relative_to(skill_md.parent.parent).as_posix()
+                description = frontmatter.get("description")
+                return None, {
+                    "object": "skill",
+                    "name": str(frontmatter.get("name") or (skill_dir.name if skill_dir else skill_md.stem)),
+                    "description": "" if description is None else str(description),
+                    "category": _get_category_from_path(skill_md),
+                    "path": path, "content": content, "body": body,
+                    "linked_files": _skill_linked_files(skill_dir)}
+
+            not_found, skill = await asyncio.to_thread(_load)
+        except Exception:
+            logger.exception("GET /v1/skills/%s failed", name)
+            return _error_response("Failed to read skill", 500, err_type="server_error")
+        if not_found:
+            return _error_response(not_found, 404, err_type="not_found_error", code="skill_not_found")
+        return web.json_response(skill)
+
