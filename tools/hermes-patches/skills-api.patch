+    @pytest.mark.asyncio
+    async def test_skill_detail_returns_skill_md(self, adapter):
+        from hermes_constants import get_hermes_home
+
+        skill_dir = get_hermes_home() / "skills" / "notes" / "api-skill-detail-probe"
+        (skill_dir / "references").mkdir(parents=True, exist_ok=True)
+        (skill_dir / "SKILL.md").write_text(
+            "---\nname: api-skill-detail-probe\ndescription: Probe skill\n---\n\n# Probe\n\nBody.\n",
+            encoding="utf-8",
+        )
+        (skill_dir / "references" / "api.md").write_text("Reference.\n", encoding="utf-8")
+        app = _create_app(adapter)
+        async with TestClient(TestServer(app)) as cli:
+            resp = await cli.get("/v1/skills/api-skill-detail-probe")
+            assert resp.status == 200
+            data = await resp.json()
+        assert data["name"] == "api-skill-detail-probe"
+        assert data["description"] == "Probe skill"
+        assert data["category"] == "notes"
+        assert data["path"] == "notes/api-skill-detail-probe/SKILL.md"
+        assert data["content"].startswith("---\nname: api-skill-detail-probe")
+        assert data["body"].strip() == "# Probe\n\nBody."
+        assert data["linked_files"] == {"references": ["references/api.md"]}
+
